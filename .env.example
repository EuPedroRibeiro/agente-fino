NEXUSTI_APP_NAME=Agente Fino
NEXUSTI_HOST=127.0.0.1
NEXUSTI_PORT=8765

AGENTE_FINO_RUNTIME=cloud
AGENTE_FINO_ENV=production
AGENTE_FINO_PUBLIC_MODE=true
AGENTE_FINO_SECURITY_ENABLED=true
AGENTE_FINO_REQUIRE_LOGIN=true
AGENTE_FINO_SESSION_SECRET=
AGENTE_FINO_SESSION_COOKIE_NAME=agente_fino_session
AGENTE_FINO_SESSION_TTL_MINUTES=720
AGENTE_FINO_ALLOWED_ORIGINS=https://SEU-PROJETO.vercel.app,http://127.0.0.1:8765,http://localhost:8765

AGENTE_FINO_ADMIN_USER=Pedro
AGENTE_FINO_ADMIN_EMAIL=
AGENTE_FINO_ADMIN_PASSWORD_HASH=

AGENTE_FINO_DB_ENGINE=postgres
DATABASE_URL=
NEXUSTI_DB_PATH=data/nexusti.db

DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=35
GEMINI_STATUS_CACHE_SECONDS=60

OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_FALLBACK_MODEL=gpt-5.4-mini
OPENAI_VERIFIER_MODEL=gpt-5.4-mini
OPENAI_USE_FOR_VERIFICATION=false
OPENAI_TIMEOUT_SECONDS=12
OPENAI_FAST_ENABLED=false
OPENAI_WEB_SEARCH_ENABLED=false

LOCAL_RULES_ONLY_FALLBACK=true
NEXUSTI_LOCAL_RULES_ENABLED=true

# Local legacy only. Cloud runtime blocks these even if filled.
NEXUSTI_OLLAMA_ENABLED=false
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:3b
NEXUSTI_OLLAMA_URL=
NEXUSTI_OLLAMA_MODEL=qwen2.5:3b
NEXUSTI_OLLAMA_FALLBACK_MODEL=llama3.1:8b
NEXUSTI_OLLAMA_HEALTH_TIMEOUT_SECONDS=2.0
NEXUSTI_OLLAMA_CHAT_TIMEOUT_SECONDS=90
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_MODEL=gpt-4o-mini
LITELLM_TIMEOUT_SECONDS=30

NEXUSTI_WEB_ENABLED=true
NEXUSTI_WEB_REQUIRE_CITATIONS=true
NEXUSTI_WEB_REQUIRE_SOURCE_RANKING=true
NEXUSTI_WEB_MAX_RESULTS=8
NEXUSTI_WEB_MAX_PAGES_FETCH=5
NEXUSTI_WEB_TIMEOUT=15
NEXUSTI_WEB_CACHE_ENABLED=true
NEXUSTI_WEB_CACHE_TTL_MINUTES=120
NEXUSTI_WEB_PROVIDER=duckduckgo_html
NEXUSTI_SEARXNG_URL=
NEXUSTI_WEB_USER_AGENT=AgenteFino-ResearchBot/2.0
NEXUSTI_WEB_SAFE_DOMAINS_ONLY=false

AGENTE_FINO_RAG_ENABLED=false
AGENTE_FINO_MEMORY_ENABLED=true
VECTOR_STORE=disabled
CHROMA_PATH=data/chroma
QDRANT_URL=
NEXUSTI_VECTOR_STORE_PROVIDER=disabled
NEXUSTI_VECTOR_STORE_URL=
NEXUSTI_EMBEDDING_PROVIDER=local-placeholder
NEXUSTI_EMBEDDING_MODEL=

NEXUS_FUSION_ENABLED=true
NEXUS_DEFAULT_MODE=balanced
NEXUS_ALLOW_MULTI_MODEL=true
NEXUS_ALLOW_VERIFIER=true
NEXUS_MAX_MODELS_PER_REQUEST=2
NEXUS_TIMEOUT_SECONDS=30
NEXUS_FAST_PROVIDER_TIMEOUT_SECONDS=6
NEXUS_FAST_TOTAL_TIMEOUT_SECONDS=4
NEXUS_BALANCED_PROVIDER_TIMEOUT_SECONDS=15
NEXUS_EXPERT_PROVIDER_TIMEOUT_SECONDS=25
NEXUS_FAST_MAX_OUTPUT_TOKENS=32

NEXUS_ENABLE_AUTONOMY=true
NEXUS_AUTONOMY_LEVEL=1
NEXUS_REQUIRE_CONFIRMATION_FOR_ACTIONS=true
NEXUS_ENABLE_LENS=true
NEXUS_ENABLE_DEEP_SEARCH=true
NEXUS_ENABLE_MISSIONS=true
NEXUS_ENABLE_ARTIFACTS=true
NEXUS_ENABLE_TRAINING_EXPORT=true

AGENTE_FINO_RATE_LIMIT_ENABLED=true
AGENTE_FINO_RATE_LIMIT_CHAT_PER_MINUTE=30
AGENTE_FINO_RATE_LIMIT_LOGIN_PER_MINUTE=10
AGENTE_FINO_RATE_LIMIT_GLOBAL_PER_MINUTE=120
AGENTE_FINO_RATE_LIMIT_TOOLS_PER_MINUTE=10
AGENTE_FINO_RATE_LIMIT_DEEP_SEARCH_PER_MINUTE=5
AGENTE_FINO_CSRF_ENABLED=true
AGENTE_FINO_CSP_ALLOW_BLOB_SCRIPT=false
AGENTE_FINO_SECURITY_HEADERS_ENABLED=true
AGENTE_FINO_AUDIT_LOG_ENABLED=true
AGENTE_FINO_UPLOADS_ENABLED=false
AGENTE_FINO_MAX_UPLOAD_MB=25
AGENTE_FINO_BLOCK_DANGEROUS_TOOLS=true
AGENTE_FINO_REQUIRE_CONFIRMATION_FOR_SYSTEM_ACTIONS=true
AGENTE_FINO_MAX_CHAT_MESSAGE_CHARS=16000
AGENTE_FINO_MAX_TITLE_CHARS=200
AGENTE_FINO_MAX_PATH_CHARS=1000
AGENTE_FINO_MAX_FILENAME_CHARS=255

DARKFOREST_ENABLED=true
DARKFOREST_PATH=./tools/DarkForest-Hunter-OpenAI
DARKFOREST_MAX_RUNTIME=120
DARKFOREST_MASK_SECRETS=true
DARKFOREST_SAVE_HISTORY=true
DARKFOREST_ALLOW_REMOTE_TARGETS=false

MCP_BRASIL_ENABLED=true
MCP_BRASIL_PATH=./tools/mcp-brasil
MCP_BRASIL_TRANSPORT=http
MCP_BRASIL_HOST=127.0.0.1
MCP_BRASIL_PORT=8766
MCP_BRASIL_AUTH_MODE=none
MCP_BRASIL_AUTO_START=true
MCP_BRASIL_TIMEOUT=60
MCP_BRASIL_ALLOWED_FEATURES=
MCP_BRASIL_DATASETS=

# DadosAbertosBrasil/PublicDataProvider. Uses official public sources and does not require an API key.
PUBLIC_DATA_ENABLED=true
PUBLIC_DATA_TIMEOUT_SECONDS=15

# Optional public-data integrations used by mcp-brasil when a source requires credentials.
TRANSPARENCIA_API_KEY=
DATAJUD_API_KEY=
META_ACCESS_TOKEN=

# Authorized CPF/CNPJ lookup provider. Keep disabled until URL and credential are configured.
DOCUMENT_LOOKUP_ENABLED=false
DOCUMENT_LOOKUP_BASE_URL=
DOCUMENT_LOOKUP_API_KEY=
DOCUMENT_LOOKUP_TIMEOUT_SECONDS=15
DOCUMENT_LOOKUP_METHOD=GET
DOCUMENT_LOOKUP_CPF_PATH=/cpf/{document}
DOCUMENT_LOOKUP_CNPJ_PATH=/cnpj/{document}
DOCUMENT_LOOKUP_API_KEY_HEADER=Authorization
DOCUMENT_LOOKUP_API_KEY_PREFIX="Bearer "
CPF_LOOKUP_RATE_LIMIT_PER_HOUR=100
CNPJ_LOOKUP_RATE_LIMIT_PER_HOUR=300

# Sherlock Consultas. CPF real keeps using the authorized DOCUMENT_LOOKUP provider.
SHERLOCK_ENABLED=true
SHERLOCK_CPF_LAB_ENABLED=true
CNPJ_LOOKUP_ENABLED=true
CNPJ_LOOKUP_PROVIDER=brasilapi
CNPJ_LOOKUP_TIMEOUT_SECONDS=10
CNPJ_CACHE_TTL_SECONDS=21600
REDIS_URL=
CONSULTA_CACHE_ENABLED=true
